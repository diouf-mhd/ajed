# Base de données (correspond au docker-compose.yml)
DATABASE_URL="postgresql://ajed:ajed@localhost:5432/ajed?schema=public"

# Mot de passe administrateur (jamais exposé au navigateur). Modifiable ici à tout moment.
ADMIN_PASSWORD="change-me"

# Clé secrète de session (générer une nouvelle valeur en production : openssl rand -hex 32)
AUTH_SECRET="change-me-openssl-rand-hex-32"

# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dossier de stockage des images (monter un volume persistant en production)
UPLOAD_DIR="./uploads"
